{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {SourceContext} {CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "CorsAllowedOrigins": [ "http://localhost:5100" ],
  "TextServices": {
    "BaseUrl": "",
    "CacheSlidingExpirationMinutes": 30,
    "CacheAbsoluteExpirationHours": 4,
    "CacheMaxEntries": 20,
    "StorageRootPath": "C:/textservices-data"
  }
}
